<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/text_primary"
        app:title="Advanced"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/SectionTitle" android:text="Output folder" />
            <TextView
                android:id="@+id/outputValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeOutputButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Change folder"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/defaultOutputButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Use default"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView style="@style/SectionTitle" android:layout_marginTop="24dp" android:text="Existing file behavior" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fileBehaviorLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:helperText="Keeps the existing file and adds (1), (2), …">
                <AutoCompleteTextView
                    android:id="@+id/fileBehaviorDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/SectionTitle" android:layout_marginTop="24dp" android:text="Root environment" />
            <ProgressBar android:id="@+id/rootProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="10dp" />
            <TextView
                android:id="@+id/rootEnvironmentValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView style="@style/SectionTitle" android:layout_marginTop="24dp" android:text="device_id" />
            <TextView
                android:id="@+id/deviceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="monospace"
                android:focusable="false"
                android:longClickable="false"
                android:textColor="@color/text_primary"
                android:textIsSelectable="false"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/revealButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:text="Reveal"
                android:textAllCaps="false" />

            <TextView style="@style/SectionTitle" android:layout_marginTop="20dp" android:text="Local tools" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/realmDebugButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Realm inspector"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/importButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Import local package"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeImportsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Remove imported packages"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearTemporaryButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Clear temporary files"
                android:textAllCaps="false" />
            <TextView
                android:id="@+id/advancedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
